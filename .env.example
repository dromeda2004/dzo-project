# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres connection string used by the app (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://dzo:dzo@localhost:5432/dzo

# Plain (non-async) URL Alembic uses for migrations
ALEMBIC_DATABASE_URL=postgresql+psycopg2://dzo:dzo@localhost:5432/dzo

APP_ENV=local
DEBUG=true

# JWT signing secret — generate a real random value per environment; never reuse
# the default across dev/staging/prod.
SECRET_KEY=dev-insecure-secret-change-in-production

# Third-party integration keys (Stripe/Maps/FCM) — provider not yet confirmed,
# see docs/DZO_TECH_ROADMAP.md section 5. Uncomment and set once needed:
# STRIPE_SECRET_KEY=
# GOOGLE_MAPS_API_KEY=
# FCM_SERVER_KEY=

# OpenTelemetry tracing — base URL of an OTLP/HTTP collector. Uncomment to send
# traces to the local Jaeger from docker-compose.yml (UI at http://localhost:16686).
# Leave unset to disable export (tests and CI run without a collector).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=dzo-backend
